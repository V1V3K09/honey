---
// index.astro — BIRTHDAY.EXE: Scroll-Driven Birthday Website Using Full-Body Character Image
import BaseLayout from '../layouts/BaseLayout.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import CharacterStage from '../components/CharacterStage.astro';
import NewspaperCard from '../components/NewspaperCard.astro';
import BirthdayCard from '../components/BirthdayCard.astro';
import BirthdayGame from '../components/BirthdayGame.astro';
import FooterExperience from '../components/FooterExperience.astro';
---

<BaseLayout>
  <!-- Designed Loading Screen -->
  <LoadingScreen />

  <!-- Persistent 2D Transparent Character Stage -->
  <CharacterStage />

  <!-- Scroll-Driven Choreography Track -->
  <main id="experience-wrapper">
    <div id="scroll-container">
      
      <!-- SECTION A: Full-Body Landing Screen -->
      <section id="stage-hero" class="experience-stage">
        <!-- Top Full-Width Headline -->
        <div class="hero-top-banner interactive-content">
          <div class="tape-strip tape-yellow" style="margin-bottom: 8px;">TOP SECRET DISPATCH #028</div>
          <h1 class="paper-headline" style="font-size: clamp(2rem, 4.5vw, 4rem);">
            <span class="cut-chunk cut-yellow">THE SPECIMEN</span>
            <span class="cut-chunk cut-pink">HAS ARRIVED</span>
          </h1>
          <p class="hero-subheading">
            100% ORGANIC • 0% COMMON SENSE • HAPPY BIRTHDAY, YOU ABSOLUTE MENACE.
          </p>
        </div>

        <!-- 3-Column Flank Grid: Left Notes | Center Aki Character | Right Newspaper -->
        <div class="hero-body-flank-grid">
          
          <!-- LEFT COLUMN: Anatomical Notes Placed Around Aki's Body -->
          <div class="hero-left-column interactive-content">
            <div class="paper-card hero-dossier-card">
              <div class="tape-strip tape-pink" style="margin-bottom: 8px;">
                ANATOMICAL NOTES
              </div>

              <h2 class="paper-headline" style="font-size: 1.4rem; justify-content: flex-start; margin-bottom: 6px;">
                <span class="cut-chunk cut-yellow">SPECIMEN:</span>
                <span class="cut-chunk cut-mint">SAINT AKI</span>
              </h2>

              <p style="font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; color: var(--ink-muted); margin-bottom: 10px;">
                "UNSHAKEABLE INNER PEACE & UNPRECEDENTED CHARISMA"
              </p>

              <!-- Anatomical Pointers wrapping around the character -->
              <div class="anatomical-pointers-list">
                <div class="anatomical-pointer-item">
                  <span class="pointer-badge">🧠 CRANIAL SECTOR • "राधे राधे"</span>
                  <p class="pointer-desc">
                    Signature headwrap locked at 100% devotional frequency. Dissipates bad vibes instantly.
                  </p>
                </div>

                <div class="anatomical-pointer-item">
                  <span class="pointer-badge">🫀 THORACIC CORE • SCARF & CHEST</span>
                  <p class="pointer-desc">
                    Pure 24-karat gold heart. Empathy telemetry exceeds municipal safety guidelines.
                  </p>
                </div>

                <div class="anatomical-pointer-item">
                  <span class="pointer-badge">⚡ KNEE JOINTS • TROUSERS</span>
                  <p class="pointer-desc">
                    Fully articulated for cake combat in Section D. Zero knee creaks detected.
                  </p>
                </div>

                <div class="anatomical-pointer-item">
                  <span class="pointer-badge">🦶 BARE FEET • GROUND ZERO</span>
                  <p class="pointer-desc">
                    100% shoe-free contact with the cosmos. The ultimate punchline awaiting at the footer.
                  </p>
                </div>
              </div>

              <!-- Vibe Stats -->
              <div class="hero-stats-row">
                <span class="stat-pill" style="background-color: var(--accent-yellow);">AURA: MAX</span>
                <span class="stat-pill" style="background-color: var(--accent-mint);">LOYALTY: 100%</span>
                <span class="stat-pill" style="background-color: var(--accent-pink); color: #FFF;">AGE: +1</span>
                <span class="stat-pill">COMMON SENSE: 0%</span>
              </div>
            </div>
          </div>

          <!-- CENTER COLUMN: Visual Space for Centered Full-Body Character -->
          <div class="hero-center-column" aria-hidden="true">
            <!-- The persistent transparent character image stands here -->
          </div>

          <!-- RIGHT COLUMN: Newspaper Cutout & Dynamic Birthday Date Banner -->
          <div class="hero-right-column">
            <NewspaperCard />
          </div>

        </div>

        <!-- Subtle Scroll Indicator -->
        <div class="scroll-prompt-landing interactive-content">
          <span class="tape-strip tape-pink">DIRECTIVE</span>
          <p style="font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700;">
            SCROLL TO INVESTIGATE THE SPECIMEN'S ANATOMY ↓
          </p>
        </div>
      </section>

      <!-- SECTION B: Face Approach Spacer -->
      <section id="stage-approach" class="experience-stage">
        <div class="approach-card paper-card interactive-content">
          <div class="tape-strip tape-pink" style="margin-bottom: 8px;">OPTICAL ZOOM IN PROGRESS</div>
          <h2 class="paper-headline" style="font-size: 1.6rem; justify-content: flex-start; margin-bottom: 12px;">
            <span class="cut-chunk cut-yellow">FACIAL</span>
            <span class="cut-chunk cut-vermilion">RECONNAISSANCE</span>
          </h2>
          <p style="font-size: 0.95rem; line-height: 1.6; color: var(--ink-muted);">
            Locking camera coordinates onto the headwrap and facial features. 
            Prepare for an unprecedented close encounter with genuine birthday charisma.
          </p>
        </div>
      </section>

      <!-- SECTION C: Face Composition & Interactive Birthday Card (Split Screen) -->
      <section id="stage-card" class="experience-stage">
        <div class="card-column-left">
          <BirthdayCard />
        </div>
        <div class="card-column-right" aria-hidden="true">
          <!-- Aki's Face frames on the right side here -->
        </div>
      </section>

      <!-- SECTION D: Torso & Knees with 3D Cake Boss Fight (Split Screen) -->
      <section id="stage-game" class="experience-stage">
        <div class="game-column-left" aria-hidden="true">
          <!-- Aki's Knees frame on the left side here -->
        </div>
        <div class="game-column-right">
          <BirthdayGame />
        </div>
      </section>

      <!-- SECTION E: Feet & The Literal Footer -->
      <section id="stage-footer" class="experience-stage">
        <FooterExperience />
      </section>

    </div>
  </main>
</BaseLayout>
