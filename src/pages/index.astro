---
// index.astro — BIRTHDAY.EXE: Scroll-Driven Birthday Website for Aki
import BaseLayout from '../layouts/BaseLayout.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import CharacterStage from '../components/CharacterStage.astro';
import NewspaperCard from '../components/NewspaperCard.astro';
import BirthdayCard from '../components/BirthdayCard.astro';
import BirthdayGame from '../components/BirthdayGame.astro';
import FooterExperience from '../components/FooterExperience.astro';
import SlipBoard from '../components/SlipBoard.astro';
---

<BaseLayout>
  <!-- Tactile Loading Screen -->
  <LoadingScreen />

  <!-- Persistent 2D Transparent Character Stage -->
  <CharacterStage />

  <!-- Scroll-Driven Choreography Track -->
  <main id="experience-wrapper">
    <div id="scroll-container">
      
      <!-- SECTION A: Full-Body Landing Screen -->
      <section id="stage-hero" class="experience-stage">
        <!-- Top Full-Width Headline -->
        <div class="hero-top-banner interactive-content">
          <h1 class="paper-headline" style="font-size: clamp(2.2rem, 5vw, 4.4rem);">
            <span class="cut-chunk cut-yellow">HAPPY BIRTHDAY,</span>
            <span class="cut-chunk cut-pink">AKI!</span>
          </h1>
          <p class="hero-subheading">
            OCTOBER 28 SPECIAL • CELEBRATING THE PURE-HEARTED MASTER OF GOOD VIBES.
          </p>
        </div>

        <!-- 3-Column Flank Grid: Left Notes | Center Aki Character | Right Newspaper -->
        <div class="hero-body-flank-grid">
          
          <!-- LEFT COLUMN: Personal & Goofy Notes Around Aki's Body -->
          <div class="hero-left-column interactive-content">
            <div class="paper-card hero-dossier-card">
              <h2 class="paper-headline" style="font-size: 1.35rem; justify-content: flex-start; margin-bottom: 6px;">
                <span class="cut-chunk cut-yellow">MEET</span>
                <span class="cut-chunk cut-mint">OUR BOY AKI</span>
              </h2>

              <p class="hero-dossier-subquote">
                "BRINGING CALMNESS, LAUGHTER & DEVOTION TO EVERY ROOM"
              </p>

              <!-- Personal Pointers wrapping around the character -->
              <div class="anatomical-pointers-list">
                <div class="anatomical-pointer-item">
                  <span class="pointer-badge">🙏 "राधे राधे" HEADWRAP & SCARF</span>
                  <p class="pointer-desc">
                    His iconic look. Radiates serene peace, positive energy, and an unshakeable sense of calm in any storm.
                  </p>
                </div>

                <div class="anatomical-pointer-item">
                  <span class="pointer-badge">❤️ GOLDEN HEART & EASY LAUGHTER</span>
                  <p class="pointer-desc">
                    Always ready to listen, laugh at anything, and make whatever stressful situation feel completely fine.
                  </p>
                </div>

                <div class="anatomical-pointer-item">
                  <span class="pointer-badge">🧘 COOL, CALM & STEADY</span>
                  <p class="pointer-desc">
                    Zero panic, zero drama. Just quiet confidence, genuine kindness, and steady devotion.
                  </p>
                </div>

                <div class="anatomical-pointer-item">
                  <span class="pointer-badge">🦶 EFFORTLESSLY BAREFOOT</span>
                  <p class="pointer-desc">
                    Completely grounded and 100% unbothered by dress codes. Stay tuned for the footer punchline!
                  </p>
                </div>
              </div>

              <!-- Genuine Vibe Badges -->
              <div class="hero-stats-row">
                <span class="stat-pill" style="background-color: var(--accent-yellow);">VIBES: IMMACULATE</span>
                <span class="stat-pill" style="background-color: var(--accent-mint);">FRIENDSHIP: FOREVER</span>
                <span class="stat-pill" style="background-color: var(--accent-pink); color: #FFF;">SWEET TOOTH: MAX</span>
                <span class="stat-pill">ENERGY: RADHE RADHE</span>
              </div>
            </div>
          </div>

          <!-- CENTER COLUMN: Visual Space for Centered Full-Body Character -->
          <div class="hero-center-column" aria-hidden="true">
            <!-- The persistent transparent character image stands here -->
          </div>

          <!-- RIGHT COLUMN: Newspaper Cutout & Dynamic Birthday Date Banner -->
          <div class="hero-right-column">
            <NewspaperCard />
          </div>

        </div>

        <!-- Rocket Touchdown Telemetry HUD (Active during rocket descent) -->
        <div id="rocket-telemetry-badge" class="rocket-telemetry-badge paper-card" role="status" aria-live="polite">
          <div class="telemetry-header">
            <span class="telemetry-radar-dot"></span>
            <span id="telemetry-status-text" class="telemetry-status-text">MISSION CONTROL: RETRO-PROPULSION ACTIVE</span>
          </div>
          <div class="telemetry-readouts">
            <span id="telemetry-alt" class="telemetry-metric">ALTITUDE: 1,200M</span>
            <span class="telemetry-divider">|</span>
            <span id="telemetry-vel" class="telemetry-metric">VELOCITY: MACH 1.8</span>
          </div>
        </div>

        <!-- Landing Actions: Replay Rocket & Scroll Indicator -->
        <div class="hero-landing-actions interactive-content">
          <button id="btn-replay-rocket" class="btn-replay-rocket" type="button" aria-label="Replay Rocket Landing">
            <span class="rocket-icon">🚀</span>
            <span>REPLAY ROCKET LANDING</span>
          </button>
          
          <div class="scroll-prompt-landing">
            <p class="scroll-prompt-text">
              SCROLL TO EXPLORE AKI'S BIRTHDAY JOURNEY ↓
            </p>
          </div>
        </div>
      </section>

      <!-- SECTION B: Face Approach Spacer -->
      <section id="stage-approach" class="experience-stage">
        <div class="approach-card paper-card interactive-content">
          <h2 class="paper-headline" style="font-size: 1.5rem; justify-content: flex-start; margin-bottom: 12px;">
            <span class="cut-chunk cut-yellow">THE FACE</span>
            <span class="cut-chunk cut-vermilion">OF TRANQUILITY</span>
          </h2>
          <p style="font-size: 0.95rem; line-height: 1.6; color: var(--ink-secondary);">
            Taking a closer look at the friend who survived another entire year of our chaotic shenanigans. 
            Keep scrolling to open your personal card for Aki!
          </p>
        </div>
      </section>

      <!-- SECTION C: Face Composition & Interactive Birthday Card (Split Screen: Face on LEFT, Card on RIGHT) -->
      <section id="stage-card" class="experience-stage">
        <div class="card-column-left" aria-hidden="true">
          <!-- Aki's Face frames on the left side here -->
        </div>
        <div class="card-column-right">
          <BirthdayCard />
        </div>
      </section>

      <!-- SECTION D: Torso & Knees with 3D "Protect His Last Brain Cell" Game (Split Screen: Game on LEFT, Knees on RIGHT) -->
      <section id="stage-game" class="experience-stage">
        <div class="game-column-left">
          <BirthdayGame />
        </div>
        <div class="game-column-right interactive-content">
          <!-- Paper-cut annotation near character: "THE OWNER OF THIS BRAIN" -->
          <div class="brain-owner-callout paper-card">
            <div class="callout-tag">
              <span>👈</span>
              <span class="cut-chunk cut-yellow" style="font-size: 0.92rem;">THE OWNER OF THIS BRAIN</span>
            </div>
            <p class="callout-caption">
              "Preserving his single lone neuron through pure Radhe Radhe serenity."
            </p>
          </div>
        </div>
      </section>

      <!-- SECTION E: The Transparent Community Wish Wall & Real-Time Guestbook -->
      <SlipBoard />

      <!-- SECTION F: Feet & The Literal Footer (Feet Section on LEFT, Bare Feet on RIGHT) -->
      <section id="stage-footer" class="experience-stage">
        <div class="footer-column-left">
          <FooterExperience />
        </div>
        <div class="footer-column-right" aria-hidden="true">
          <!-- Aki's bare feet frame cleanly in this spatial area on the right -->
        </div>
      </section>

    </div>
  </main>
</BaseLayout>
