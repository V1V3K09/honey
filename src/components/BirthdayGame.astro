---
// BirthdayGame.astro — Interactive Arcade Mini-Game for Aki's Birthday Feast
---

<div 
  id="cake-boss-container" 
  class="cake-boss-card arcade-game-card interactive-content" 
  tabindex="0"
  role="region"
  aria-label="Aki's Birthday Feast Arcade Game"
>
  <h3 class="boss-title">
    <span class="cut-chunk cut-yellow">CATCH</span>
    <span class="cut-chunk cut-pink">AKI'S BIRTHDAY TREATS</span>
  </h3>

  <!-- Arcade HUD Bar -->
  <div class="arcade-hud">
    <div class="hud-item">
      <span class="hud-label">SCORE</span>
      <div class="hud-score-display">
        <span class="arcade-score-val">0</span>
        <span class="hud-score-target">/ 300</span>
      </div>
    </div>
    <div class="hud-item">
      <span class="hud-label">COMBO</span>
      <span class="arcade-combo-val hud-highlight">x0</span>
    </div>
    <div class="hud-item">
      <span class="hud-label">CANDLES</span>
      <span class="arcade-lives-val">🕯️🕯️🕯️</span>
    </div>
  </div>

  <!-- Progress Bar toward Victory -->
  <div class="arcade-progress-bar" title="Target: 300 points to complete the feast!">
    <div class="arcade-progress-fill" style="width: 0%;"></div>
  </div>

  <!-- Game Canvas Stage -->
  <div class="game-canvas-wrapper" title="Move your mouse or finger to slide Aki's Feast Plate!">
    <canvas class="game-canvas"></canvas>

    <!-- Start Screen Overlay -->
    <div class="game-start-overlay">
      <div class="game-intro-icon">🎂 🪔 🍬</div>
      <h4 class="game-intro-title">AKI'S BIRTHDAY FEAST</h4>
      <p class="game-intro-desc">
        Catch birthday cake slices (+20), Radhe Radhe blessings (+50) & gift boxes (+70)!<br />
        Dodge falling Monday alarms, bills & back aches!
      </p>
      <button class="btn-action btn-start-game" type="button">
        START FEAST ▶
      </button>
    </div>

    <!-- Game Over Overlay -->
    <div class="game-over-overlay" style="display: none;">
      <div class="game-intro-icon">🕯️💔</div>
      <h4 class="game-over-title">ALMOST HAD IT!</h4>
      <p class="game-intro-desc">Those Monday alarms got in the way! Give it another shot for Aki.</p>
      <button class="btn-action game-restart-btn" type="button">
        TRY AGAIN ↺
      </button>
    </div>

    <!-- Victory Overlay -->
    <div class="game-victory-overlay" role="dialog" aria-modal="true" aria-label="Arcade Feast Conquered Victory">
      <div class="victory-trophy" aria-hidden="true">🏆</div>
      <h3 class="victory-title">
        <span class="cut-chunk cut-mint">FEAST COMPLETE!</span>
      </h3>
      <p class="victory-perk">
        You collected all the birthday sweets for Aki! Wishing him infinite happiness and blessings!
      </p>
      <button class="btn-action game-restart-btn" type="button">
        PLAY AGAIN ↺
      </button>
    </div>
  </div>

  <!-- Dynamic Taunt / Tip Bubble -->
  <div class="game-taunt" aria-live="polite">
    "SLIDE THE PLATE TO CATCH CAKES & SWEET BLESSINGS!"
  </div>

  <!-- Controls Hints -->
  <div class="game-controls-hint">
    <span>🖱️ MOUSE / DRAG TO MOVE</span>
    <span>⌨️ [A][D] OR ARROWS TO SLIDE</span>
  </div>
</div>

<style>
  .arcade-game-card {
    position: relative;
    user-select: none;
    background-color: var(--glass-paper);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: var(--border-ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-elevation);
    padding: 24px;
    outline: none;
  }

  .boss-title {
    display: flex;
    justify-content: flex-start;
    gap: 8px;
    margin: 0 0 14px;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  /* Arcade HUD */
  .arcade-hud {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #FAF7F0;
    border: var(--border-ink-thin);
    border-radius: var(--radius-md);
    padding: 8px 16px;
    margin-bottom: 10px;
  }

  .hud-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .hud-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }

  .hud-score-display {
    display: flex;
    align-items: baseline;
    gap: 4px;
    font-family: var(--font-mono);
    font-weight: 800;
  }

  .arcade-score-val {
    font-size: 1.2rem;
    color: var(--accent-vermilion);
  }

  .hud-score-target {
    font-size: 0.78rem;
    color: var(--ink-muted);
  }

  .arcade-combo-val {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--accent-violet);
  }

  .arcade-lives-val {
    font-size: 1rem;
    letter-spacing: 2px;
  }

  /* Progress Bar */
  .arcade-progress-bar {
    width: 100%;
    height: 10px;
    background-color: #ECE5D8;
    border: var(--border-ink-thin);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 12px;
  }

  .arcade-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-yellow), var(--accent-mint));
    transition: width 180ms ease;
  }

  /* Canvas and Overlays */
  .game-canvas-wrapper {
    position: relative;
    width: 100%;
    height: 320px;
    background-color: #FAF7F0;
    border: var(--border-ink);
    border-radius: var(--radius-md);
    margin-bottom: 12px;
    overflow: hidden;
    touch-action: none;
    cursor: grab;
  }

  .game-canvas-wrapper:active {
    cursor: grabbing;
  }

  .game-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .game-start-overlay,
  .game-over-overlay {
    position: absolute;
    inset: 0;
    background: rgba(251, 248, 241, 0.95);
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
    z-index: 35;
  }

  .game-intro-icon {
    font-size: 2.2rem;
    margin-bottom: 8px;
  }

  .game-intro-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }

  .game-intro-desc {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-secondary);
    max-width: 320px;
    margin-bottom: 18px;
  }

  .game-over-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--accent-vermilion);
    margin: 4px 0 8px;
  }

  .victory-trophy {
    font-size: 3rem;
    margin-bottom: 8px;
    animation: bounceTrophy 1s ease-in-out infinite alternate;
  }

  @keyframes bounceTrophy {
    from { transform: scale(1); }
    to { transform: scale(1.15) rotate(5deg); }
  }

  .victory-title {
    margin-bottom: 12px;
  }

  .victory-perk {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: 18px;
    max-width: 340px;
    color: var(--ink-primary);
  }
</style>

<script>
  import { AkiArcadeGame } from '../scripts/arcade-game';

  function initArcadeGame() {
    const container = document.getElementById('cake-boss-container');
    if (!container) return;

    try {
      new AkiArcadeGame(container);
    } catch (err) {
      console.warn('Could not initialize Aki Arcade Game:', err);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArcadeGame);
  } else {
    initArcadeGame();
  }
</script>
