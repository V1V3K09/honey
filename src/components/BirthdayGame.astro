---
// BirthdayGame.astro — "PROTECT HIS LAST BRAIN CELL" 3D Mini-Game Component
import '../styles/game-styles.css';
---

<div 
  id="brain-game-container" 
  class="brain-game-card interactive-content" 
  tabindex="0"
  role="region"
  aria-label="Protect His Last Brain Cell Mini-Game"
>
  <!-- Header -->
  <div class="brain-game-header">
    <h3 class="paper-headline brain-game-title">
      <span class="cut-chunk cut-yellow">PROTECT</span>
      <span class="cut-chunk cut-pink">HIS LAST BRAIN CELL</span>
    </h3>
    <button id="btn-game-pause" class="btn-game-pause" type="button" aria-label="Pause or Resume Game">
      ⏸ PAUSE
    </button>
  </div>

  <!-- Primary HUD Bar -->
  <div class="brain-hud-grid">
    <!-- Timer -->
    <div class="hud-cell">
      <span class="hud-cell-label">SURVIVE</span>
      <span id="hud-timer-display" class="hud-timer-display">00:45</span>
    </div>

    <!-- Brain Integrity Bar -->
    <div class="hud-cell">
      <div class="hud-integrity-meta">
        <span class="hud-cell-label">BRAIN INTEGRITY</span>
        <span id="hud-integrity-display" class="hud-integrity-text">100%</span>
      </div>
      <div class="brain-integrity-bar">
        <div id="hud-integrity-fill" class="brain-integrity-fill" style="width: 100%;"></div>
      </div>
    </div>

    <!-- Score -->
    <div class="hud-cell" style="text-align: right;">
      <span class="hud-cell-label">SCORE</span>
      <span id="hud-score-display" class="hud-score-val">0 PTS</span>
    </div>
  </div>

  <!-- Secondary Metrics Bar -->
  <div class="brain-metrics-subbar">
    <span id="hud-blocked-display">0 BLOCKED</span>
    <span id="hud-samosas-display">0 SAMOSAS</span>
    <span id="hud-rank-preview">RANK: INTERN</span>
  </div>

  <!-- 3D Game Canvas Stage -->
  <div class="brain-canvas-wrapper" title="Drag your mouse or finger to move the energy shield!">
    <canvas class="brain-game-canvas"></canvas>

    <!-- START SCREEN OVERLAY -->
    <div id="overlay-start" class="brain-overlay">
      <div class="overlay-badge">DEFENSE ARENA</div>
      <h4 class="overlay-title">PROTECT HIS LAST BRAIN CELL</h4>
      <p class="overlay-desc">
        Survive <strong>45 seconds</strong> of adult life! Move your shield to intercept alarm clocks, exams, and responsibilities. Collect golden samosas!
      </p>
      <button id="btn-start-game" class="btn-action" type="button">
        START DEFENSE ▶
      </button>
    </div>

    <!-- PAUSED OVERLAY -->
    <div id="overlay-paused" class="brain-overlay" style="display: none;">
      <div class="overlay-badge">PAUSED</div>
      <h4 class="overlay-title">BRAIN CELL PAUSED</h4>
      <p class="overlay-desc">
        Taking a quick breather from adult responsibilities.
      </p>
      <button id="btn-resume-game" class="btn-action" type="button">
        RESUME DEFENSE ▶
      </button>
    </div>

    <!-- DEFEAT OVERLAY -->
    <div id="overlay-defeat" class="brain-overlay" style="display: none;">
      <div class="overlay-badge" style="background-color: var(--accent-vermilion); color: #fff;">GAME OVER</div>
      <h4 class="overlay-title" style="color: var(--accent-vermilion);">
        THE LAST BRAIN CELL HAS LEFT THE CHAT
      </h4>
      <p class="overlay-desc">
        Overwhelmed by alarm clocks and responsibilities! His thoughts have flatlined.
      </p>
      <div class="stats-summary-card">
        <div>
          <div class="stat-item-label">TIME SURVIVED</div>
          <div id="defeat-time-val" class="stat-item-val">0s</div>
        </div>
        <div>
          <div class="stat-item-label">FINAL SCORE</div>
          <div id="defeat-score-val" class="stat-item-val">0 PTS</div>
        </div>
        <div id="defeat-rank-val" class="rank-pill">RANK: BRAIN CELL INTERN</div>
      </div>
      <button id="btn-retry-game" class="btn-action" type="button">
        TRY AGAIN ↺
      </button>
    </div>

    <!-- VICTORY OVERLAY -->
    <div id="overlay-victory" class="brain-overlay" style="display: none;">
      <div class="overlay-badge" style="background-color: var(--accent-mint); color: var(--ink-primary);">VICTORY</div>
      <h4 class="overlay-title" style="color: var(--accent-mint);">
        THE LAST BRAIN CELL SURVIVED!
      </h4>
      
      <!-- Birthday Reward Box -->
      <div class="victory-reward-box">
        <div class="reward-heading">BIRTHDAY REWARD UNLOCKED</div>
        <div class="reward-quote">"HAPPY BIRTHDAY, YOU ABSOLUTE MENACE."</div>
      </div>

      <div class="stats-summary-card">
        <div>
          <div class="stat-item-label">TIME SURVIVED</div>
          <div class="stat-item-val">45.0s (FULL)</div>
        </div>
        <div>
          <div class="stat-item-label">FINAL SCORE</div>
          <div id="victory-score-val" class="stat-item-val">0 PTS</div>
        </div>
        <div>
          <div class="stat-item-label">THREATS BLOCKED</div>
          <div id="victory-blocked-val" class="stat-item-val">0</div>
        </div>
        <div>
          <div class="stat-item-label">SAMOSAS GRABBED</div>
          <div id="victory-samosas-val" class="stat-item-val">0</div>
        </div>
        <div id="victory-rank-val" class="rank-pill">GUARDIAN OF THE LAST NEURON</div>
      </div>

      <button id="btn-unlock-card" class="btn-action btn-unlock-card" type="button">
        UNLOCK YOUR BIRTHDAY CARD
      </button>
      <button id="btn-replay-game" class="btn-action" type="button" style="font-size: 0.85rem; padding: 6px 14px;">
        PLAY AGAIN ↺
      </button>
    </div>
  </div>

  <!-- Dynamic Dialogue / Status Bubble -->
  <div id="game-dialogue-bubble" class="brain-dialogue-bubble" aria-live="polite">
    "DEFEND THE LAST NEURON FROM ADULT REALITY!"
  </div>

  <!-- Controls Hint -->
  <div class="brain-controls-hint">
    <span>MOUSE / TOUCH DRAG TO MOVE SHIELD</span>
    <span>[A][D] / ARROWS • [ESC] PAUSE</span>
  </div>
</div>

<script>
  import confetti from 'canvas-confetti';
  import { BrainGameLogic, type GameState, type GameStats } from '../scripts/brain-game/game-logic';
  import { BrainGameScene } from '../scripts/brain-game/game-scene';
  import { sfx } from '../scripts/audio-fx';

  function initBrainGame() {
    const container = document.getElementById('brain-game-container');
    if (!container) return;

    // UI Element references
    const timerDisplay = document.getElementById('hud-timer-display');
    const integrityDisplay = document.getElementById('hud-integrity-display');
    const integrityFill = document.getElementById('hud-integrity-fill');
    const scoreDisplay = document.getElementById('hud-score-display');
    const blockedDisplay = document.getElementById('hud-blocked-display');
    const samosasDisplay = document.getElementById('hud-samosas-display');
    const rankPreview = document.getElementById('hud-rank-preview');
    const dialogueBubble = document.getElementById('game-dialogue-bubble');
    const pauseToggleBtn = document.getElementById('btn-game-pause');

    // Overlays
    const startOverlay = document.getElementById('overlay-start');
    const pausedOverlay = document.getElementById('overlay-paused');
    const defeatOverlay = document.getElementById('overlay-defeat');
    const victoryOverlay = document.getElementById('overlay-victory');

    // Action buttons
    const startBtn = document.getElementById('btn-start-game');
    const resumeBtn = document.getElementById('btn-resume-game');
    const retryBtn = document.getElementById('btn-retry-game');
    const replayBtn = document.getElementById('btn-replay-game');
    const unlockCardBtn = document.getElementById('btn-unlock-card');

    let scene: BrainGameScene | null = null;

    const logic = new BrainGameLogic({
      onStateChange: (state: GameState) => {
        if (startOverlay) startOverlay.style.display = state === 'ready' ? 'flex' : 'none';
        if (pausedOverlay) pausedOverlay.style.display = state === 'paused' ? 'flex' : 'none';
        if (defeatOverlay) defeatOverlay.style.display = state === 'defeat' ? 'flex' : 'none';
        if (victoryOverlay) victoryOverlay.style.display = state === 'victory' ? 'flex' : 'none';

        if (pauseToggleBtn) {
          pauseToggleBtn.textContent = state === 'paused' ? '▶ RESUME' : '⏸ PAUSE';
          pauseToggleBtn.style.display = (state === 'playing' || state === 'paused') ? 'block' : 'none';
        }
      },

      onIntegrityChange: (integrity: number, max: number) => {
        const pct = Math.max(0, Math.min(100, (integrity / max) * 100));
        if (integrityDisplay) integrityDisplay.textContent = `${Math.round(pct)}%`;
        if (integrityFill) {
          integrityFill.style.width = `${pct}%`;
          integrityFill.classList.toggle('is-warning', pct <= 50 && pct > 20);
          integrityFill.classList.toggle('is-danger', pct <= 20);
        }
      },

      onTimerUpdate: (secondsLeft: number) => {
        const wholeSecs = Math.ceil(secondsLeft);
        const mins = Math.floor(wholeSecs / 60);
        const secs = wholeSecs % 60;
        const str = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        if (timerDisplay) {
          timerDisplay.textContent = str;
          timerDisplay.classList.toggle('is-low', wholeSecs <= 10);
        }
      },

      onScoreUpdate: (score: number) => {
        if (scoreDisplay) scoreDisplay.textContent = `${score} PTS`;
      },

      onStatsUpdate: (stats: GameStats) => {
        if (blockedDisplay) blockedDisplay.textContent = `${stats.threatsBlocked} BLOCKED`;
        if (samosasDisplay) samosasDisplay.textContent = `${stats.samosasCollected} SAMOSAS`;
        if (rankPreview) rankPreview.textContent = `RANK: ${stats.rank.split(' ')[0]}`;
      },

      onDialogue: (text: string, type: 'info' | 'warn' | 'success' | 'danger' = 'info') => {
        if (dialogueBubble) {
          dialogueBubble.textContent = `"${text}"`;
          dialogueBubble.className = `brain-dialogue-bubble is-${type}`;
        }
      },

      onThreatBlocked: (threat) => {
        if (scene) scene.onThreatBlocked(threat.x, threat.y);
      },

      onDamageTaken: (damage, threat) => {
        if (scene) scene.onDamageTaken(threat.x, threat.y);
      },

      onCollectibleGrabbed: (item) => {
        if (scene) scene.onCollectibleGrabbed(item.x, item.y, item.type === 'golden-samosa');
      },

      onVictory: (stats: GameStats) => {
        sfx.playVictory();
        confetti({
          particleCount: 150,
          spread: 85,
          origin: { y: 0.6 },
          colors: ['#00e599', '#ffe600', '#ff2e7e', '#7038ff', '#ff4b00']
        });

        const vScore = document.getElementById('victory-score-val');
        const vBlocked = document.getElementById('victory-blocked-val');
        const vSamosas = document.getElementById('victory-samosas-val');
        const vRank = document.getElementById('victory-rank-val');

        if (vScore) vScore.textContent = `${stats.score} PTS`;
        if (vBlocked) vBlocked.textContent = stats.threatsBlocked.toString();
        if (vSamosas) vSamosas.textContent = stats.samosasCollected.toString();
        if (vRank) vRank.textContent = `RANK: ${stats.rank}`;
      },

      onDefeat: (stats: GameStats) => {
        sfx.playHit(true);
        const dTime = document.getElementById('defeat-time-val');
        const dScore = document.getElementById('defeat-score-val');
        const dRank = document.getElementById('defeat-rank-val');

        if (dTime) dTime.textContent = `${stats.timeSurvived}s`;
        if (dScore) dScore.textContent = `${stats.score} PTS`;
        if (dRank) dRank.textContent = `RANK: ${stats.rank}`;
      }
    });

    try {
      scene = new BrainGameScene(container, logic);
    } catch (err) {
      console.warn('Could not initialize Three.js Brain Game Scene:', err);
    }

    // Bind Button Actions
    const handleStart = () => {
      logic.start();
    };

    if (startBtn) startBtn.addEventListener('click', handleStart);
    if (resumeBtn) resumeBtn.addEventListener('click', () => logic.resume());
    if (retryBtn) retryBtn.addEventListener('click', handleStart);
    if (replayBtn) replayBtn.addEventListener('click', handleStart);

    if (pauseToggleBtn) {
      pauseToggleBtn.addEventListener('click', () => {
        if (logic.getState() === 'playing') {
          logic.pause();
        } else if (logic.getState() === 'paused') {
          logic.resume();
        }
      });
    }

    // Connect Birthday Card Integration
    if (unlockCardBtn) {
      unlockCardBtn.addEventListener('click', () => {
        sfx.playVictory();
        
        // Dispatch global birthday card unseal event
        window.dispatchEvent(new CustomEvent('birthday:open-card'));

        // Smooth scroll to the birthday card section
        const cardSection = document.getElementById('stage-card');
        if (cardSection) {
          cardSection.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBrainGame);
  } else {
    initBrainGame();
  }
</script>
