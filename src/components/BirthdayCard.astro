---
// BirthdayCard.astro — Interactive paper envelope and personal birthday letter for Aki
---

<div class="birthday-card-container interactive-content">
  <!-- Closed Envelope Trigger -->
  <div 
    id="envelope-trigger" 
    class="envelope-trigger" 
    role="button" 
    tabindex="0"
    aria-label="Open Birthday Card for Aki"
  >
    <div class="wax-seal" aria-hidden="true">🎂</div>
    <h3 class="envelope-title">
      <span class="cut-chunk cut-yellow" style="font-size: 1.15rem;">A BIRTHDAY NOTE</span>
      <span class="cut-chunk cut-pink" style="font-size: 1.15rem;">FOR AKI</span>
    </h3>
    <p class="envelope-hint">CLICK OR PRESS ENTER TO UNSEAL ✉️</p>
  </div>

  <!-- Unfolded Letter Modal -->
  <div id="letter-modal" class="letter-modal" role="dialog" aria-modal="true" aria-labelledby="letter-heading">
    <h3 id="letter-heading" class="letter-recipient">
      DEAR <span class="cut-chunk cut-vermilion" style="font-size: 1.3rem;">AKI</span>,
    </h3>

    <div class="letter-body">
      <p>
        Happy Birthday, Aki! Another wonderful trip around the sun in the books.
      </p>
      <p>
        Thank you for being the calmest, kindest presence in our lives. Whether you're rocking your signature <em>Radhe Radhe</em> headwrap, laughing off life's chaotic moments, or just being there for your friends with zero hesitation, you make everything lighter and funnier.
      </p>
      <p>
        You are truly one of a kind and an irreplaceable friend. May this upcoming year bring you boundless happiness, steady peace of mind, excellent health, and an endless supply of your favorite sweet treats!
      </p>
    </div>

    <!-- Polaroid Photo Frame with Aki's Photo -->
    <div class="letter-photo-frame">
      <div class="photo-container">
        <img 
          src="/images/aki.png" 
          alt="Aki smiling in his Radhe Radhe headwrap" 
          class="photo-img"
        />
      </div>
      <p class="photo-caption">"Aki in his natural state — peaceful, smiling, and radiating pure good energy."</p>
    </div>

    <div class="letter-signature">
      <p class="signature-main">HAPPY BIRTHDAY, LEGEND!</p>
      <p class="signature-handwritten">— With all our love & Radhe Radhe always ❤️</p>
    </div>

    <button id="btn-close-letter" class="btn-action btn-close-letter" type="button">
      CLOSE NOTE & CONTINUE JOURNEY ✕
    </button>
  </div>
</div>

<style>
  .birthday-card-container {
    width: 100%;
    position: relative;
    z-index: 30;
  }

  .envelope-trigger {
    width: 100%;
    background-color: var(--glass-cardboard);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: var(--border-ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-elevation);
    padding: 34px 24px;
    text-align: center;
    cursor: pointer;
    position: relative;
    z-index: 30;
    user-select: none;
    transition-property: transform, box-shadow;
    transition-duration: 150ms;
    transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }

  @media (hover: hover) {
    .envelope-trigger:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-elevation-lg);
    }
  }

  .envelope-trigger:active {
    transform: scale(0.96) translateY(1px);
    box-shadow: var(--shadow-hard-press);
  }

  .envelope-trigger:focus-visible {
    outline: 2px solid var(--accent-vermilion);
    outline-offset: 3px;
  }

  .wax-seal {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: var(--accent-vermilion);
    border: var(--border-ink);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    margin: 0 auto 16px;
    box-shadow: 2px 2px 0 var(--ink-primary);
  }

  .envelope-title {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }

  .envelope-hint {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
  }

  /* Unfolded Letter Modal with Emil Kowalski Spring Animation */
  .letter-modal {
    display: none;
    background-color: var(--glass-paper);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: var(--border-ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-elevation-lg);
    padding: 32px 28px;
    position: relative;
    z-index: 35;
    box-sizing: border-box;
  }

  .letter-modal.is-open {
    display: block;
    animation: unfoldLetter 340ms cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
  }

  @keyframes unfoldLetter {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(12px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: blur(0px);
    }
  }

  .letter-recipient {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    letter-spacing: -0.02em;
  }

  .letter-body {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--ink-primary);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .letter-photo-frame {
    margin: 20px 0;
    padding: 12px;
    border: var(--border-ink-thin);
    background-color: #FFFFFF;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-hard-sm);
    text-align: center;
    position: relative;
  }

  .photo-container {
    background: #FAFAFA;
    padding: 8px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(18, 19, 22, 0.1);
  }

  .photo-img {
    width: 100%;
    max-width: 260px;
    height: auto;
    margin: 0 auto;
    display: block;
    border-radius: var(--radius-sm);
    filter: contrast(1.04);
  }

  .photo-caption {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    margin-top: 10px;
    color: var(--ink-secondary);
  }

  .letter-signature {
    margin-top: 20px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
  }

  .signature-handwritten {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--accent-vermilion);
    margin-top: 4px;
  }

  .btn-close-letter {
    margin-top: 20px;
    width: 100%;
    background-color: var(--accent-mint);
  }
</style>

<script>
  import confetti from 'canvas-confetti';
  import { sfx } from '../scripts/audio-fx';

  function setupBirthdayCard() {
    const trigger = document.getElementById('envelope-trigger');
    const modal = document.getElementById('letter-modal');
    const closeBtn = document.getElementById('btn-close-letter');

    if (!trigger || !modal || !closeBtn) return;

    const openCard = () => {
      trigger.style.display = 'none';
      modal.classList.add('is-open');
      sfx.playPop();

      // Celebratory confetti flutter on card open
      confetti({
        particleCount: 50,
        spread: 60,
        origin: { y: 0.6 }
      });

      closeBtn.focus();
    };

    const closeCard = () => {
      modal.classList.remove('is-open');
      trigger.style.display = 'block';
      sfx.playPop();
      trigger.focus();
    };

    trigger.addEventListener('click', openCard);
    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openCard();
      }
    });

    closeBtn.addEventListener('click', closeCard);

    // Escape key closes modal
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeCard();
      }
    });

    // Global integration event from mini-game or other components
    window.addEventListener('birthday:open-card', () => {
      openCard();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupBirthdayCard);
  } else {
    setupBirthdayCard();
  }
</script>
