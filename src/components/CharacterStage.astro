---
// CharacterStage.astro — Persistent 2D Transparent Character Stage
---

<div id="character-stage-viewport" class="character-viewport" aria-hidden="true">
  <!-- Dynamic Rocket Thruster Canvas: Plumes, Sparks, Mach Diamonds, Ground Smoke & Shockwaves -->
  <canvas id="rocket-thruster-canvas" class="thruster-canvas"></canvas>

  <!-- Rocket Landing Carrier: Handles Foreground Descent & Docking Without Touching Frame Tweens -->
  <div id="rocket-landing-wrapper" class="rocket-landing-wrapper">
    <div id="character-frame" class="character-frame">
      <img 
        id="character-img"
        src="/images/friend-fullbody.png" 
        alt="Aki - Full Body Character" 
        class="character-img"
        loading="eager"
      />
    </div>
  </div>
</div>

<style>
  .character-viewport {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: 5; /* Main character sits behind the interactive cards (z-index 10-30) */
    pointer-events: none;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thruster-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    pointer-events: none;
    z-index: 10;
  }

  .rocket-landing-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: 50% 50%;
    will-change: transform;
    pointer-events: none;
  }

  .character-frame {
    position: relative;
    height: 82vh;
    max-height: 740px;
    width: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: 50% 14%;
    will-change: transform;
    filter: drop-shadow(0 14px 28px rgba(18, 19, 22, 0.22));
    z-index: 5;
  }

  .character-img {
    height: 100%;
    width: auto;
    object-fit: contain;
    display: block;
    user-select: none;
  }

  @media (max-width: 768px) {
    .character-frame {
      height: 70vh;
      max-height: 560px;
    }
  }
</style>

<script>
  import { initCharacterScroll } from '../scripts/character-controller';
  import { rocketLanding } from '../scripts/rocket-landing';

  const setupStage = () => {
    initCharacterScroll();
    rocketLanding.init();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupStage);
  } else {
    setupStage();
  }
</script>
