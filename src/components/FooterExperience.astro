---
// FooterExperience.astro — The literal feet punchline, credits, and interactive navigation
---

<footer class="footer-punchline-card paper-card interactive-content">
  <h3 class="paper-headline" style="font-size: 1.55rem; margin-bottom: 14px;">
    <span class="cut-chunk cut-yellow">YES, THIS IS</span>
    <span class="cut-chunk cut-pink">THE FOOTER.</span>
    <span class="cut-chunk cut-mint">LITERALLY HIS FEET.</span>
  </h3>

  <p class="footer-desc">
    You have traveled all the way from head to toe with our legendary friend <strong>Aki</strong>!
    Completely barefoot, completely unbothered, and living life on his own serene terms.
  </p>

  <!-- Pointers toward the feet on the right -->
  <div class="footer-pointer-arrow">
    <span>👉</span>
    <span>EXHIBIT B: 100% UNBOTHERED, BAREFOOT & THRIVING</span>
  </div>

  <div class="footer-nav">
    <button id="btn-scroll-top" class="btn-action" type="button">
      TELEPORT TO TOP ⤒
    </button>
    <button id="btn-confetti-footer" class="btn-action" type="button" style="background-color: var(--accent-pink); color: #FFF;">
      CONFETTI BLASTER 🎉
    </button>
  </div>

  <div class="footer-credit">
    <p>COMPILED WITH LOVE & LAUGHTER FOR AKI'S BIRTHDAY • RADHE RADHE!</p>
    <p style="font-size: 0.74rem; color: var(--ink-muted); margin-top: 4px;">
      OCTOBER 28 • WISHING YOU INFINITE HAPPINESS & SWEET MOMENTS
    </p>
  </div>
</footer>

<style>
  .footer-desc {
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--ink-secondary);
    max-width: 480px;
    margin: 0 auto 16px;
  }

  .footer-credit {
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px dashed rgba(18, 19, 22, 0.2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
  }
</style>

<script>
  import confetti from 'canvas-confetti';
  import { sfx } from '../scripts/audio-fx';

  function setupFooter() {
    const scrollTopBtn = document.getElementById('btn-scroll-top');
    const confettiBtn = document.getElementById('btn-confetti-footer');

    if (scrollTopBtn) {
      scrollTopBtn.addEventListener('click', () => {
        sfx.playWhoosh();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    if (confettiBtn) {
      confettiBtn.addEventListener('click', () => {
        sfx.playVictory();
        confetti({
          particleCount: 90,
          spread: 80,
          origin: { y: 0.85 },
          colors: ['#ff4b00', '#ffe600', '#ff2e7e', '#00e599', '#7038ff']
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFooter);
  } else {
    setupFooter();
  }
</script>
