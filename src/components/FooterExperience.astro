---
// FooterExperience.astro — The literal feet punchline, credits, social link, and interactive navigation
---

<footer class="footer-punchline-card paper-card interactive-content">
  <h3 class="paper-headline" style="font-size: 1.55rem; margin-bottom: 14px;">
    <span class="cut-chunk cut-yellow">THIS IS</span>
    <span class="cut-chunk cut-mint">THE FOOTER SECTION</span>
  </h3>

  <!-- Social Link: FIND ME AT @aki.medicos -->
  <div class="footer-find-me">
    <span class="find-me-label">FIND ME AT</span>
    <a 
      href="https://instagram.com/aki.medicos" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="find-me-pill"
      aria-label="Find Aki at @aki.medicos on Instagram"
      title="Open @aki.medicos on Instagram"
    >
      <span class="find-me-handle">@aki.medicos</span>
      <span class="find-me-arrow" aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="footer-nav">
    <button id="btn-scroll-top" class="btn-action" type="button">
      TELEPORT TO TOP
    </button>
    <button id="btn-confetti-footer" class="btn-action" type="button" style="background-color: var(--accent-pink); color: #FFF;">
      CONFETTI BLASTER
    </button>
  </div>

  <div class="footer-credit">
    <p>COMPILED WITH LOVE & LAUGHTER FOR AKI'S BIRTHDAY • RADHE RADHE!</p>
  </div>
</footer>

<style>
  /* Social Link / Find Me Pill */
  .footer-find-me {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin: 4px 0 16px;
    background: var(--bg-paper-alt);
    border: var(--border-ink-thin);
    border-radius: var(--radius-md);
    padding: 8px 14px;
    box-shadow: var(--shadow-hard-sm);
  }

  .find-me-label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
  }

  .find-me-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--accent-yellow);
    color: var(--ink-primary);
    border: var(--border-ink-thin);
    border-radius: var(--radius-sm);
    padding: 5px 12px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: var(--shadow-hard-sm);
    transition-property: transform, box-shadow, background-color;
    transition-duration: 140ms;
    transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }

  @media (hover: hover) {
    .find-me-pill:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-hard-md);
      background-color: #FFF04D;
    }
    .find-me-pill:hover .find-me-arrow {
      transform: translate(2px, -2px);
    }
  }

  .find-me-pill:active {
    transform: scale(0.96) translateY(1px);
    box-shadow: var(--shadow-hard-press);
  }

  .find-me-arrow {
    font-size: 0.85rem;
    color: var(--accent-vermilion);
    transition: transform 140ms ease;
  }

  .footer-credit {
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px dashed rgba(18, 19, 22, 0.2);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
  }
</style>

<script>
  import confetti from 'canvas-confetti';
  import { sfx } from '../scripts/audio-fx';

  function setupFooter() {
    const scrollTopBtn = document.getElementById('btn-scroll-top');
    const confettiBtn = document.getElementById('btn-confetti-footer');

    if (scrollTopBtn) {
      scrollTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    if (confettiBtn) {
      confettiBtn.addEventListener('click', () => {
        sfx.playVictory();
        confetti({
          particleCount: 90,
          spread: 80,
          origin: { y: 0.85 },
          colors: ['#ff4b00', '#ffe600', '#ff2e7e', '#00e599', '#7038ff']
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFooter);
  } else {
    setupFooter();
  }
</script>
