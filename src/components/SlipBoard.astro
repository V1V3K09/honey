---
// SlipBoard.astro — Transparent Community Wish Wall & Emil Kowalski Sticky Note UI
import '../styles/slipboard.css';
---

<!-- 1. The Transparent Community Wish Wall (Directly on the screen, not in a drawer) -->
<section id="stage-wall" class="experience-stage stage-notes-wall interactive-content" aria-label="Aki's Community Wish Wall">
  <div class="wall-layout-container">
    
    <!-- Wall Header Card -->
    <header class="wall-header-card">
      <div class="wall-title-group">
        <h2 class="wall-headline">
          <span aria-hidden="true">📌</span>
          <span class="cut-chunk cut-yellow">AKI'S WISH WALL</span>
          <span class="cut-chunk cut-pink">PINNED LIVE</span>
        </h2>
        <p class="wall-subtitle">
          Every note, goofy roast, and heartfelt wish left by friends around the globe. Live & reactive!
        </p>
      </div>

      <div class="wall-status-group">
        <span id="wall-slip-count-badge" class="slip-count-badge">0 SLIPS PINNED</span>
        <!-- Live Sync & io_uring Batching Telemetry Indicator -->
        <div id="slipboard-sync-badge" class="slipboard-sync-badge" title="io_uring asynchronous batch ring buffer active">
          <span id="sync-status-dot" class="sync-status-dot is-local"></span>
          <span id="sync-status-label" class="sync-status-label">INITIALIZING...</span>
        </div>
      </div>
    </header>

    <!-- Wall Split Layout: Notes Grid on Left & Center | Physical Sticky Trigger on Right -->
    <div class="wall-split-layout">
      
      <!-- LEFT / CENTER: Transparent Screen Surface where Notes are visible directly -->
      <div class="transparent-wall-surface">
        <div id="slips-masonry-container" class="wall-slips-grid" role="list">
          <!-- Rendered dynamically by script -->
        </div>
      </div>

      <!-- RIGHT: Tactile Physical Sticky Note Widget -->
      <aside class="wall-sticky-trigger-column">
        <div 
          id="sticky-note-trigger" 
          class="sticky-note-physical-card"
          role="button"
          tabindex="0"
          aria-label="Click to write a note and paste it on the wall"
        >
          <!-- Paper Washi Tape -->
          <div class="sticky-washi-tape" aria-hidden="true"></div>
          <!-- Dog-Ear Fold Corner -->
          <div class="sticky-dog-ear" aria-hidden="true"></div>

          <div class="sticky-card-content">
            <span class="sticky-card-stamp" aria-hidden="true">✍️</span>
            <h3 class="sticky-card-title">
              <span class="cut-chunk cut-yellow" style="font-size: 1.05rem; padding: 2px 6px;">PIN YOUR</span>
              <span class="cut-chunk cut-pink" style="font-size: 1.05rem; padding: 2px 6px;">OWN NOTE!</span>
            </h3>
            <p class="sticky-card-desc">
              Have a birthday wish, funny memory, or friendly roast for Aki? Click here to write and paste it on the transparent wall!
            </p>
            <div class="sticky-card-btn-fake">
              <span>📌</span>
              <span>+ WRITE & PASTE NOTE</span>
            </div>
          </div>
        </div>
      </aside>

    </div>
  </div>
</section>

<!-- 2. Floating Quick Sticky Dock Pill (Always visible on right edge for fast access) -->
<aside class="floating-sticky-dock interactive-content" aria-label="Quick Pin Note">
  <button 
    id="btn-quick-stick" 
    class="btn-floating-sticky" 
    type="button" 
    aria-label="Open Note Composer"
    title="Click to write and paste a note on Aki's wall"
  >
    <span class="dock-pin" aria-hidden="true">📌</span>
    <span class="dock-label">STICK A NOTE</span>
    <span id="dock-count-badge" class="dock-count">0</span>
  </button>
</aside>

<!-- 3. Emil Kowalski Glassmorphic Sticky Note Composer Modal -->
<div 
  id="note-composer-modal" 
  class="note-composer-modal-backdrop interactive-content" 
  role="dialog" 
  aria-modal="true" 
  aria-labelledby="composer-modal-title"
  style="display: none;"
>
  <div class="note-composer-dialog">
    <div class="composer-dialog-header">
      <div class="composer-header-title-row">
        <span class="composer-icon" aria-hidden="true">✍️</span>
        <h3 id="composer-modal-title" class="composer-headline">
          <span class="cut-chunk cut-yellow" style="font-size: 1.15rem; padding: 2px 8px;">STICK A NOTE</span>
          <span class="cut-chunk cut-pink" style="font-size: 1.15rem; padding: 2px 8px;">FOR AKI</span>
        </h3>
      </div>
      <button id="btn-close-composer" class="btn-composer-close" type="button" aria-label="Close Composer">
        ✕
      </button>
    </div>

    <form id="slip-composer-form">
      <div class="composer-grid">
        <div class="form-group">
          <label for="slip-author" class="form-label">YOUR NAME / NICKNAME *</label>
          <input 
            type="text" 
            id="slip-author" 
            class="form-input" 
            placeholder="e.g. Rahul, Medicos Gang, Tanya" 
            maxlength="36" 
            required 
          />
        </div>

        <div class="form-group">
          <label for="slip-tag" class="form-label">WHO ARE YOU TO AKI?</label>
          <input 
            type="text" 
            id="slip-tag" 
            class="form-input" 
            placeholder="e.g. College Friend, Childhood Crew" 
            maxlength="32" 
          />
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 14px;">
        <label for="slip-message" class="form-label">YOUR BIRTHDAY NOTE *</label>
        <textarea 
          id="slip-message" 
          class="form-textarea" 
          placeholder="Write a sweet message, hilarious memory, or birthday roast for Aki..." 
          maxlength="280" 
          required
        ></textarea>
      </div>

      <!-- Customization: Pastel Paper Color & Stamp Selection -->
      <div class="composer-grid" style="margin-bottom: 10px;">
        <div class="form-group">
          <span class="form-label">PASTEL NOTE COLOR</span>
          <div id="color-picker-group" class="color-picker-row">
            <button type="button" class="color-option is-selected" data-color="yellow" style="background-color: #FEF08A;" aria-label="Yellow Paper"></button>
            <button type="button" class="color-option" data-color="pink" style="background-color: #FCE7F3;" aria-label="Pink Paper"></button>
            <button type="button" class="color-option" data-color="mint" style="background-color: #DCFCE7;" aria-label="Mint Paper"></button>
            <button type="button" class="color-option" data-color="sky" style="background-color: #E0F2FE;" aria-label="Sky Blue Paper"></button>
            <button type="button" class="color-option" data-color="kraft" style="background-color: #F5ECE1;" aria-label="Kraft Cardboard"></button>
          </div>
        </div>

        <div class="form-group">
          <span class="form-label">STICKER STAMP</span>
          <div id="stamp-picker-group" class="stamp-picker-row">
            <button type="button" class="stamp-option is-selected" data-stamp="🎂" aria-label="Cake">🎂</button>
            <button type="button" class="stamp-option" data-stamp="👑" aria-label="Crown">👑</button>
            <button type="button" class="stamp-option" data-stamp="🚀" aria-label="Rocket">🚀</button>
            <button type="button" class="stamp-option" data-stamp="🥟" aria-label="Samosa">🥟</button>
            <button type="button" class="stamp-option" data-stamp="🪷" aria-label="Radhe Radhe">🪷</button>
            <button type="button" class="stamp-option" data-stamp="🧠" aria-label="Brain">🧠</button>
            <button type="button" class="stamp-option" data-stamp="✨" aria-label="Vibes">✨</button>
          </div>
        </div>
      </div>

      <div class="composer-bottom-bar">
        <span id="char-counter" class="char-counter">0 / 280 CHARACTERS</span>
        <button id="btn-submit-slip" class="btn-paste-on-wall" type="submit">
          <span aria-hidden="true">📌</span>
          <span>PASTE IT ON THE WALL</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  import confetti from 'canvas-confetti';
  import { sfx } from '../scripts/audio-fx';
  import { ConvexClient } from 'convex/browser';
  import { api } from '../../convex/_generated/api';
  import type { Doc } from '../../convex/_generated/dataModel';
  import { IoUringBatcher, type IoUringStats, type SlipColor } from '../scripts/io-uring-buffer';

  type SlipDoc = Doc<'slips'>;

  interface Slip {
    id: string;
    author: string;
    tag: string;
    message: string;
    color: SlipColor;
    stamp: string;
    timestamp: string;
    likes: number;
    rotation: number;
    isCustom?: boolean;
  }

  class SlipBoardManager {
    private wallCountBadge: HTMLElement | null = null;
    private dockCountBadge: HTMLElement | null = null;
    private container: HTMLElement | null = null;
    private rightTrigger: HTMLElement | null = null;
    private quickDockBtn: HTMLElement | null = null;
    
    // Modal & Form Elements
    private modal: HTMLElement | null = null;
    private closeBtn: HTMLElement | null = null;
    private form: HTMLFormElement | null = null;
    private messageInput: HTMLTextAreaElement | null = null;
    private charCounter: HTMLElement | null = null;
    
    // Sync Telemetry
    private syncBadge: HTMLElement | null = null;
    private syncDot: HTMLElement | null = null;
    private syncLabel: HTMLElement | null = null;

    private batcher!: IoUringBatcher;
    private convex: ConvexClient | null = null;
    private myCreatedIds: Set<string> = new Set();

    private selectedColor: SlipColor = 'yellow';
    private selectedStamp: string = '🎂';
    private slips: Slip[] = [];
    private likedSlipIds: Set<string> = new Set();
    private isComposerOpen: boolean = false;

    constructor() {}

    public init() {
      this.wallCountBadge = document.getElementById('wall-slip-count-badge');
      this.dockCountBadge = document.getElementById('dock-count-badge');
      this.container = document.getElementById('slips-masonry-container');
      this.rightTrigger = document.getElementById('sticky-note-trigger');
      this.quickDockBtn = document.getElementById('btn-quick-stick');

      this.modal = document.getElementById('note-composer-modal');
      this.closeBtn = document.getElementById('btn-close-composer');
      this.form = document.getElementById('slip-composer-form') as HTMLFormElement;
      this.messageInput = document.getElementById('slip-message') as HTMLTextAreaElement;
      this.charCounter = document.getElementById('char-counter');

      this.syncBadge = document.getElementById('slipboard-sync-badge');
      this.syncDot = document.getElementById('sync-status-dot');
      this.syncLabel = document.getElementById('sync-status-label');

      this.loadMyCreatedIds();
      this.loadLikes();
      this.loadCachedSlips();
      this.setupConvexAndBatcher();
      this.bindEvents();
      this.renderSlips();
      this.updateCountBadge();
    }

    private setupConvexAndBatcher() {
      const convexUrl = (import.meta.env.PUBLIC_CONVEX_URL || '').trim();

      if (convexUrl && convexUrl.startsWith('http')) {
        try {
          this.convex = new ConvexClient(convexUrl);
          this.batcher = new IoUringBatcher(this.convex);
          this.setSyncStatus('live', 'LIVE MULTIPLAYER ACTIVE');

          // Real-time reactive query subscription
          this.convex.onUpdate(api.slips.list, {}, (remoteDocs: SlipDoc[]) => {
            this.handleRemoteSlipsUpdate(remoteDocs);
          });
        } catch (err) {
          console.warn('[SlipBoard] Convex init skipped, running local ring buffer:', err);
          this.batcher = new IoUringBatcher(null);
          this.setSyncStatus('local', 'LOCAL RING BUFFER');
        }
      } else {
        // Fallback: Local in-memory ring buffer with offline localStorage sync
        this.batcher = new IoUringBatcher(null);
        this.setSyncStatus('local', 'READY (LOCAL RING BUFFER)');
      }

      // Listen to io_uring background batch telemetry
      window.addEventListener('birthday:io-uring-stats', (e: Event) => {
        const stats = (e as CustomEvent<IoUringStats>).detail;
        if (stats.sqPending > 0) {
          this.setSyncStatus('syncing', `SYNCING (${stats.sqPending} IN SQ RING)`);
        } else if (this.convex) {
          this.setSyncStatus('live', 'LIVE MULTIPLAYER ACTIVE');
        } else {
          this.setSyncStatus('local', 'READY (LOCAL RING BUFFER)');
        }
      });
    }

    private setSyncStatus(mode: 'live' | 'local' | 'syncing', label: string) {
      if (this.syncLabel) {
        this.syncLabel.textContent = label;
      }
      if (this.syncDot) {
        this.syncDot.className = `sync-status-dot is-${mode}`;
      }
    }

    private handleRemoteSlipsUpdate(remoteDocs: SlipDoc[]) {
      if (!Array.isArray(remoteDocs)) return;

      const remoteSlips: Slip[] = remoteDocs.map(doc => {
        const isMine = this.myCreatedIds.has(doc.clientSubmissionId) || this.myCreatedIds.has(doc._id);
        return {
          id: doc._id,
          author: doc.author,
          tag: doc.tag,
          message: doc.message,
          color: doc.color,
          stamp: doc.stamp,
          timestamp: this.formatRelativeTime(doc.createdAt),
          likes: doc.likes,
          rotation: doc.rotation,
          isCustom: isMine
        };
      });

      // Keep any optimistic items created locally that have not yet been reflected in the remote list
      const serverClientIds = new Set(remoteDocs.map(d => d.clientSubmissionId));
      const pendingOptimistic = this.slips.filter(s => s.isCustom && !serverClientIds.has(s.id));

      this.slips = [...pendingOptimistic, ...remoteSlips];
      this.saveCachedSlips();
      this.renderSlips();
      this.updateCountBadge();
    }

    private loadCachedSlips() {
      try {
        const stored = localStorage.getItem('aki_birthday_slips');
        if (stored) {
          const userSlips: Slip[] = JSON.parse(stored);
          this.slips = userSlips;
        } else {
          this.slips = [];
        }
      } catch {
        this.slips = [];
      }
    }

    private loadLikes() {
      try {
        const storedLikes = localStorage.getItem('aki_slip_liked_ids');
        if (storedLikes) {
          this.likedSlipIds = new Set(JSON.parse(storedLikes));
        }
      } catch {
        this.likedSlipIds = new Set();
      }
    }

    private loadMyCreatedIds() {
      try {
        const stored = localStorage.getItem('aki_my_created_ids');
        if (stored) {
          this.myCreatedIds = new Set(JSON.parse(stored));
        }
      } catch {
        this.myCreatedIds = new Set();
      }
    }

    private saveCachedSlips() {
      try {
        localStorage.setItem('aki_birthday_slips', JSON.stringify(this.slips));
      } catch (e) {
        console.warn('Could not save slips to localStorage:', e);
      }
    }

    private saveLikes() {
      try {
        localStorage.setItem('aki_slip_liked_ids', JSON.stringify(Array.from(this.likedSlipIds)));
      } catch (e) {
        console.warn('Could not save likes to localStorage:', e);
      }
    }

    private saveMyCreatedIds() {
      try {
        localStorage.setItem('aki_my_created_ids', JSON.stringify(Array.from(this.myCreatedIds)));
      } catch (e) {
        console.warn('Could not save my created IDs:', e);
      }
    }

    private bindEvents() {
      // 1. Right-side Sticky Note triggers the Composer Box
      this.rightTrigger?.addEventListener('click', () => {
        this.openComposer();
      });
      this.rightTrigger?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          this.openComposer();
        }
      });

      // 2. Floating Quick Sticky Dock triggers the Composer Box
      this.quickDockBtn?.addEventListener('click', () => {
        this.openComposer();
      });

      // 3. Close Composer
      this.closeBtn?.addEventListener('click', () => this.closeComposer());

      // Close on backdrop click outside dialog
      this.modal?.addEventListener('click', (e) => {
        if (e.target === this.modal) {
          this.closeComposer();
        }
      });

      // Close on Escape key
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.isComposerOpen) {
          this.closeComposer();
        }
      });

      // Color picker selection
      const colorBtns = document.querySelectorAll('.color-option');
      colorBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          colorBtns.forEach(b => b.classList.remove('is-selected'));
          btn.classList.add('is-selected');
          this.selectedColor = (btn.getAttribute('data-color') as SlipColor) || 'yellow';
          sfx.playPop();
        });
      });

      // Stamp picker selection
      const stampBtns = document.querySelectorAll('.stamp-option');
      stampBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          stampBtns.forEach(b => b.classList.remove('is-selected'));
          btn.classList.add('is-selected');
          this.selectedStamp = btn.getAttribute('data-stamp') || '🎂';
          sfx.playPop();
        });
      });

      // Character counter
      this.messageInput?.addEventListener('input', () => {
        const count = this.messageInput?.value.length || 0;
        if (this.charCounter) {
          this.charCounter.textContent = `${count} / 280 CHARACTERS`;
        }
      });

      // Form submission
      this.form?.addEventListener('submit', (e) => {
        e.preventDefault();
        this.handleFormSubmit();
      });
    }

    public openComposer() {
      this.isComposerOpen = true;
      if (this.modal) {
        this.modal.style.display = 'flex';
      }
      document.body.classList.add('slipboard-locked');
      sfx.playPop();

      // Focus author input with a tiny delay for smooth spring
      setTimeout(() => {
        const authorField = document.getElementById('slip-author') as HTMLInputElement;
        authorField?.focus();
      }, 150);
    }

    public closeComposer() {
      this.isComposerOpen = false;
      if (this.modal) {
        this.modal.style.display = 'none';
      }
      document.body.classList.remove('slipboard-locked');
      sfx.playPop();
    }

    private handleFormSubmit() {
      const authorInput = document.getElementById('slip-author') as HTMLInputElement;
      const tagInput = document.getElementById('slip-tag') as HTMLInputElement;
      const message = this.messageInput?.value.trim();
      const author = authorInput?.value.trim();
      const tag = tagInput?.value.trim() || 'Aki Fan Club';

      if (!author || !message) return;

      // Random organic rotation between -2.5 and +2.5 degrees
      const rot = (Math.random() * 5 - 2.5);
      const clientSubmissionId = `slip-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;

      // Track local authorship
      this.myCreatedIds.add(clientSubmissionId);
      this.saveMyCreatedIds();

      const newSlip: Slip = {
        id: clientSubmissionId,
        author,
        tag,
        message,
        color: this.selectedColor,
        stamp: this.selectedStamp,
        timestamp: 'Just now',
        likes: 1,
        rotation: parseFloat(rot.toFixed(1)),
        isCustom: true
      };

      // Automatically mark as liked by author
      this.likedSlipIds.add(newSlip.id);
      this.saveLikes();

      // 1. Instant Optimistic UI (Zero perceived latency for visitor!)
      this.slips.unshift(newSlip);
      this.saveCachedSlips();

      // Close composer box smoothly
      this.closeComposer();

      // Play victory audio + paper affix thump
      sfx.playVictory();
      sfx.playTouchdown();

      // Confetti burst across the screen
      confetti({
        particleCount: 75,
        spread: 80,
        origin: { y: 0.6, x: 0.7 },
        colors: ['#FFE135', '#FF471A', '#38E1B0', '#FF77AA', '#38B6FF']
      });

      // Clear form
      this.form?.reset();
      if (this.charCounter) {
        this.charCounter.textContent = '0 / 280 CHARACTERS';
      }

      // Re-render wall
      this.renderSlips();
      this.updateCountBadge();

      // 2. Enqueue into io_uring ring buffer for coalesced batching
      this.batcher.enqueueSlip({
        author: newSlip.author,
        tag: newSlip.tag,
        message: newSlip.message,
        color: newSlip.color,
        stamp: newSlip.stamp,
        rotation: newSlip.rotation,
        clientSubmissionId,
      });

      // Smooth scroll down to slips wall so the visitor sees their note pasted!
      setTimeout(() => {
        const wall = document.getElementById('stage-wall');
        wall?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 100);
    }

    private updateCountBadge() {
      const total = this.slips.length;
      if (this.wallCountBadge) {
        this.wallCountBadge.textContent = total === 1 ? '1 SLIP PINNED' : `${total} SLIPS PINNED`;
      }
      if (this.dockCountBadge) {
        this.dockCountBadge.textContent = `${total}`;
      }
    }

    private renderSlips() {
      if (!this.container) return;
      this.container.innerHTML = '';

      if (this.slips.length === 0) {
        const emptyEl = document.createElement('div');
        emptyEl.className = 'empty-slips-card';
        emptyEl.innerHTML = `
          <div class="washi-tape" aria-hidden="true"></div>
          <span style="font-size: 2.2rem;" aria-hidden="true">📌</span>
          <h4 class="empty-headline">THE WISH WALL IS FRESH & CLEAN</h4>
          <p class="empty-desc">
            No sticky notes have been pasted yet. Click the yellow sticky note on the right to be the very first person to pin a wish or roast for Aki!
          </p>
          <button id="btn-empty-paste" class="btn-paste-on-wall" type="button" style="margin-top: 6px;">
            <span>✍️</span>
            <span>PASTE THE FIRST NOTE</span>
          </button>
        `;

        emptyEl.querySelector('#btn-empty-paste')?.addEventListener('click', () => {
          this.openComposer();
        });

        this.container.appendChild(emptyEl);
        return;
      }

      this.slips.forEach(slip => {
        const isLiked = this.likedSlipIds.has(slip.id);
        const slipEl = document.createElement('article');
        slipEl.className = `paper-slip slip-${slip.color}`;
        slipEl.style.transform = `rotate(${slip.rotation}deg)`;
        slipEl.setAttribute('role', 'listitem');

        slipEl.innerHTML = `
          <!-- Faux Washi Tape -->
          <div class="washi-tape" aria-hidden="true"></div>

          ${slip.isCustom ? `<span class="just-pinned-badge">YOUR PIN 📌</span>` : ''}

          <!-- Header -->
          <div class="slip-header">
            <div class="slip-author-meta">
              <span class="slip-author-name">${this.escapeHTML(slip.author)}</span>
              <span class="slip-author-tag">${this.escapeHTML(slip.tag)}</span>
            </div>
            <span class="slip-stamp-icon" aria-hidden="true">${slip.stamp}</span>
          </div>

          <!-- Message Body -->
          <p class="slip-body">${this.escapeHTML(slip.message)}</p>

          <!-- Footer -->
          <div class="slip-footer">
            <span class="slip-timestamp">${slip.timestamp}</span>
            <button class="btn-slip-like ${isLiked ? 'is-liked' : ''}" type="button" data-id="${slip.id}" aria-label="Like this slip">
              <span>${isLiked ? '❤️' : '🤍'}</span>
              <span class="like-count">${slip.likes}</span>
            </button>
          </div>
        `;

        // Like button interaction with spring animation
        const likeBtn = slipEl.querySelector('.btn-slip-like');
        likeBtn?.addEventListener('click', () => {
          this.handleLikeToggle(slip, likeBtn as HTMLButtonElement);
        });

        this.container?.appendChild(slipEl);
      });
    }

    private handleLikeToggle(slip: Slip, btn: HTMLButtonElement) {
      const hasLiked = this.likedSlipIds.has(slip.id);
      let delta = 0;

      if (hasLiked) {
        this.likedSlipIds.delete(slip.id);
        slip.likes = Math.max(0, slip.likes - 1);
        delta = -1;
        btn.classList.remove('is-liked');
        btn.innerHTML = `<span>🤍</span><span class="like-count">${slip.likes}</span>`;
      } else {
        this.likedSlipIds.add(slip.id);
        slip.likes += 1;
        delta = 1;
        btn.classList.add('is-liked');
        btn.innerHTML = `<span>❤️</span><span class="like-count">${slip.likes}</span>`;
        sfx.playPop();
      }

      this.saveLikes();
      this.saveCachedSlips();

      // Enqueue like delta into io_uring write coalescer!
      this.batcher.enqueueLike(slip.id, delta);
    }

    private formatRelativeTime(epochMs: number): string {
      const diffSec = Math.floor((Date.now() - epochMs) / 1000);
      if (diffSec < 60) return 'Just now';
      const diffMin = Math.floor(diffSec / 60);
      if (diffMin < 60) return `${diffMin}m ago`;
      const diffHours = Math.floor(diffMin / 60);
      if (diffHours < 24) return `${diffHours}h ago`;
      const diffDays = Math.floor(diffHours / 24);
      if (diffDays === 1) return 'Yesterday';
      if (diffDays < 7) return `${diffDays}d ago`;
      return new Date(epochMs).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
    }

    private escapeHTML(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  }

  // Initialize on load
  const slipManager = new SlipBoardManager();

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => slipManager.init());
  } else {
    slipManager.init();
  }

  // Global event integration
  window.addEventListener('birthday:open-slipboard', () => {
    slipManager.openComposer();
  });
</script>
