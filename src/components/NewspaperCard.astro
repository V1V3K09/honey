---
// NewspaperCard.astro — Authentic Newsprint Clipping & Dynamic Birthday Date Banner
---

<div class="newspaper-card-container interactive-content">
  <!-- DYNAMIC BIRTHDAY BANNER -->
  <div class="dynamic-birthday-pill paper-card">
    <h3 id="hero-dynamic-bday-headline" class="dynamic-headline-compact">
      <span class="cut-chunk cut-yellow">IT'S 28TH OCT</span>
      <span class="cut-chunk cut-pink">TODAY IS MY BIRTHDAY!</span>
    </h3>
    <p id="hero-dynamic-bday-subtext" class="dynamic-subtext-compact">
      Cake, blessings, and warm wishes are strictly mandatory for Aki today.
    </p>
    <div class="date-chip">
      <span class="chip-dot"></span>
      <span id="hero-live-date-label">OCTOBER 28 • THE BIG DAY</span>
    </div>
  </div>

  <!-- AUTHENTIC NEWSPAPER CUTOUT -->
  <article class="hero-newspaper-clipping">
    <div class="newspaper-masthead">
      <div class="newspaper-meta-bar">
        <span>THE AKI CHRONICLE</span>
        <span>OCTOBER 28 SPECIAL EDITION</span>
        <span>PRICE: 1 WARM HUG</span>
      </div>
      <h2 class="newspaper-title">THE AKI CHRONICLE</h2>
      <p class="newspaper-tagline">
        "DEVOTION, GOOD VIBES, GENTLE WISDOM & ZERO DRAMA"
      </p>
    </div>

    <h4 class="newspaper-headline">
      LOCAL LEGEND AKI TURNS A YEAR WISER; REMAINS DEDICATED TO RADHE RADHE & SWEET TREATS
    </h4>

    <div class="newspaper-columns">
      <div class="newspaper-col">
        <p class="story-lead">
          <span class="drop-cap">I</span>N CELEBRATION of another wonderful year, family and close friends gathered today in honor of <strong>Aki</strong>, who has officially completed another solar orbit while remaining the calmest, kindest soul in any room.
        </p>
        <p>
          Adorned in his signature <em>Radhe Radhe</em> headwrap, matching scarf, and an easygoing smile, Aki was spotted enjoying his special day with deep gratitude and zero stress.
        </p>
      </div>
      <div class="newspaper-col">
        <p>
          "You can bring any chaotic emergency to Aki, and his gentle laugh instantly puts everything in perspective," his friends confirmed. "He is pure gold."
        </p>
        <blockquote class="newspaper-pullquote">
          "KEEP YOUR HEART PURE, SMILE THROUGH THE CHAOS, AND NEVER SAY NO TO BIRTHDAY CAKE."
          <cite>— Aki</cite>
        </blockquote>
      </div>
    </div>

    <div class="newspaper-stamp-bar">
      <span>COMPILED WITH LOVE BY FRIENDS</span>
      <span class="official-seal">CERTIFIED BEST FRIEND ★★★★★</span>
    </div>
  </article>
</div>

<style>
  .newspaper-card-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 440px;
    width: 100%;
  }

  /* Dynamic Birthday Pill (Emil Kowalski Glass + Better-UI elevation) */
  .dynamic-birthday-pill {
    padding: 20px 22px;
  }

  .dynamic-headline-compact {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.25;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .dynamic-subtext-compact {
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink-secondary);
    margin-bottom: 12px;
    line-height: 1.45;
  }

  .date-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--bg-paper-alt);
    border: var(--border-ink-thin);
    border-radius: 999px;
    padding: 4px 12px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .chip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--accent-mint);
    animation: pulseDot 1.5s infinite;
  }

  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
  }

  /* Authentic Newspaper Clipping */
  .hero-newspaper-clipping {
    background-color: #F8F5EC;
    border: var(--border-ink);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-elevation);
    padding: 22px 20px;
    position: relative;
    background-image: 
      radial-gradient(#23252a 0.5px, transparent 0.5px),
      radial-gradient(#d3cbbd 0.5px, #F8F5EC 0.5px);
    background-size: 16px 16px;
    background-position: 0 0, 8px 8px;
  }

  .newspaper-masthead {
    border-bottom: 2px double #23252A;
    padding-bottom: 8px;
    margin-bottom: 12px;
    text-align: center;
  }

  .newspaper-meta-bar {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    border-bottom: 1px solid #121316;
    padding-bottom: 4px;
    margin-bottom: 6px;
    color: var(--ink-secondary);
  }

  .newspaper-title {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #121316;
    margin: 4px 0 2px;
    text-transform: uppercase;
  }

  .newspaper-tagline {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--ink-muted);
    letter-spacing: 0.02em;
  }

  .newspaper-headline {
    font-family: var(--font-display);
    font-size: 0.96rem;
    font-weight: 800;
    line-height: 1.35;
    text-transform: uppercase;
    margin-bottom: 12px;
    border-bottom: 1px solid #D2CDC2;
    padding-bottom: 6px;
    letter-spacing: -0.015em;
  }

  .newspaper-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    font-size: 0.8rem;
    line-height: 1.55;
    color: #1A1A1A;
    text-align: justify;
  }

  .drop-cap {
    float: left;
    font-family: var(--font-display);
    font-size: 2.2rem;
    line-height: 0.8;
    padding-top: 2px;
    padding-right: 6px;
    font-weight: 800;
    color: var(--accent-vermilion);
  }

  .newspaper-pullquote {
    border-left: 2.5px solid var(--accent-vermilion);
    padding-left: 8px;
    margin: 8px 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.74rem;
    line-height: 1.35;
    color: var(--ink-primary);
  }

  .newspaper-pullquote cite {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    font-style: normal;
    color: var(--accent-vermilion);
    margin-top: 4px;
  }

  .newspaper-stamp-bar {
    margin-top: 14px;
    padding-top: 8px;
    border-top: 1px dashed #B8B0A2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--ink-muted);
  }

  .official-seal {
    background-color: var(--accent-mint);
    color: #121316;
    padding: 3px 8px;
    border-radius: var(--radius-cut);
    border: 1px solid #121316;
  }

  @media (max-width: 900px) {
    .newspaper-columns {
      grid-template-columns: 1fr;
      text-align: left;
    }
  }
</style>

<script>
  function setupNewspaperDate() {
    const headline = document.getElementById('hero-dynamic-bday-headline');
    const subtext = document.getElementById('hero-dynamic-bday-subtext');
    const dateLabel = document.getElementById('hero-live-date-label');

    const now = new Date();
    const currentYear = now.getFullYear();
    const currentMonth = now.getMonth();
    const currentDate = now.getDate();

    const bdayDate = new Date(currentYear, 9, 28);
    const todayMidnight = new Date(currentYear, currentMonth, currentDate);
    const diffDays = Math.round((todayMidnight.getTime() - bdayDate.getTime()) / (1000 * 60 * 60 * 24));

    const monthNames = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
    if (dateLabel) {
      dateLabel.textContent = `LIVE: ${monthNames[currentMonth]} ${currentDate}`;
    }

    if (headline && subtext) {
      if (diffDays === 0) {
        headline.innerHTML = `
          <span class="cut-chunk cut-yellow">IT'S 28TH OCT</span>
          <span class="cut-chunk cut-pink">TODAY IS MY BIRTHDAY!</span>
        `;
        subtext.textContent = 'Cake, blessings, and warm wishes are strictly mandatory for Aki today.';
      } else if (diffDays === 1) {
        headline.innerHTML = `
          <span class="cut-chunk cut-yellow">YESTERDAY WAS</span>
          <span class="cut-chunk cut-pink">MY BIRTHDAY!</span>
        `;
        subtext.textContent = 'On 28th of Oct, Aki officially leveled up. Tributes and warm hugs still welcome!';
      } else if (diffDays > 1 && diffDays <= 7) {
        headline.innerHTML = `
          <span class="cut-chunk cut-yellow">ON 28TH OF OCT</span>
          <span class="cut-chunk cut-pink">IT WAS MY BIRTHDAY</span>
          <span class="cut-chunk cut-mint">(${diffDays} DAYS AGO)</span>
        `;
        subtext.textContent = 'The birthday celebration continues! Radiating pure Radhe Radhe energy.';
      } else if (diffDays > 7 && diffDays <= 365) {
        headline.innerHTML = `
          <span class="cut-chunk cut-yellow">ON 28TH OF OCT</span>
          <span class="cut-chunk cut-pink">IT WAS MY BIRTHDAY</span>
        `;
        subtext.textContent = `Celebrating ${diffDays} days of Aki's new year of wisdom, kindness, and smiles.`;
      } else {
        const daysUntil = -diffDays;
        headline.innerHTML = `
          <span class="cut-chunk cut-yellow">MY BIRTHDAY IS ON</span>
          <span class="cut-chunk cut-pink">28TH OCT</span>
          <span class="cut-chunk cut-mint">(${daysUntil} DAYS TO GO)</span>
        `;
        subtext.textContent = 'Counting down the days to celebrate our legendary friend Aki!';
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNewspaperDate);
  } else {
    setupNewspaperDate();
  }
</script>
