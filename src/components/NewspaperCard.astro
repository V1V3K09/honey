---
// NewspaperCard.astro — Authentic Newsprint Clipping & Dynamic Birthday Date Banner
---

<div class="newspaper-card-container interactive-content">
  <!-- DYNAMIC BIRTHDAY BANNER -->
  <div class="dynamic-birthday-pill paper-card">
    <div class="tape-strip tape-pink" style="margin-bottom: 6px;">
      LIVE CALENDAR TELEMETRY
    </div>
    <h3 id="hero-dynamic-bday-headline" class="dynamic-headline-compact">
      <span class="cut-chunk cut-yellow">IT'S 28TH OCT</span>
      <span class="cut-chunk cut-pink">TODAY IS MY BIRTHDAY!</span>
    </h3>
    <p id="hero-dynamic-bday-subtext" class="dynamic-subtext-compact">
      ALL HOMAGE, SWEETS & GOOD VIBES ARE NOW MANDATORY FOR SAINT AKI.
    </p>
    <div class="date-chip">
      <span class="chip-dot"></span>
      <span id="hero-live-date-label">OCTOBER 28 • ASCENSION DAY</span>
    </div>
  </div>

  <!-- AUTHENTIC NEWSPAPER CUTOUT -->
  <article class="hero-newspaper-clipping">
    <div class="tape-strip tape-yellow newspaper-tape-tl">SPECIAL REPORT</div>
    <div class="tape-strip tape-pink newspaper-tape-tr">VOL. XXVIII</div>

    <div class="newspaper-masthead">
      <div class="newspaper-meta-bar">
        <span>THE DAILY RADHE</span>
        <span>OCTOBER 28 JUBILEE</span>
        <span>PRICE: 1 CAKE SLICE</span>
      </div>
      <h2 class="newspaper-title">THE AKI CHRONICLE</h2>
      <p class="newspaper-tagline">
        "SERENITY, RADHE RADHE DEVOTION & ZERO COMMON SENSE"
      </p>
    </div>

    <h4 class="newspaper-headline">
      SAINT AKI ACHIEVES SUPREME NIRVANA; REMAINS DEDICATED TO RADHE RADHE & SWEET TREATS
    </h4>

    <div class="newspaper-columns">
      <div class="newspaper-col">
        <p class="story-lead">
          <span class="drop-cap">I</span>N AN UNPRECEDENTED occurrence, local legend <strong>Aki</strong> has officially turned one year older while attaining a level of inner tranquility never before documented in human history.
        </p>
        <p>
          Adorned in his signature <em>Radhe Radhe</em> headwrap, matching scarf, and bare feet, Aki was spotted in deep contemplation, palms gently folded in eternal blessing.
        </p>
      </div>
      <div class="newspaper-col">
        <p>
          "He brings peace to any hurricane," confirmed close friends. "You can come to Aki with total panic, and his serene smile makes everything feel completely manageable."
        </p>
        <blockquote class="newspaper-pullquote">
          "INNER PEACE IS SACRED, BUT DID SOMEONE BRING THE CAKE?"
          <cite>— Saint Aki</cite>
        </blockquote>
      </div>
    </div>

    <div class="newspaper-stamp-bar">
      <span>OFFICIAL FRIENDSHIP ARCHIVE</span>
      <span class="official-seal">CERTIFIED LEGEND ★★★★★</span>
    </div>
  </article>
</div>

<style>
  .newspaper-card-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 440px;
    width: 100%;
  }

  /* Dynamic Birthday Pill */
  .dynamic-birthday-pill {
    padding: 16px 20px;
    background-color: #FFFFFF;
  }

  .dynamic-headline-compact {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.25;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 6px;
    text-transform: uppercase;
  }

  .dynamic-subtext-compact {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink-muted);
    margin-bottom: 10px;
    line-height: 1.4;
  }

  .date-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--bg-paper-alt);
    border: var(--border-ink-thin);
    border-radius: 999px;
    padding: 3px 10px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .chip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--accent-mint);
    animation: pulseDot 1.5s infinite;
  }

  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
  }

  /* Newspaper Clipping */
  .hero-newspaper-clipping {
    background-color: #F8F5EC;
    border: 2px solid #23252A;
    box-shadow: var(--shadow-hard-md);
    padding: 20px 18px;
    position: relative;
    background-image: 
      radial-gradient(#23252a 0.5px, transparent 0.5px),
      radial-gradient(#d3cbbd 0.5px, #F8F5EC 0.5px);
    background-size: 16px 16px;
    background-position: 0 0, 8px 8px;
  }

  .newspaper-tape-tl {
    position: absolute;
    top: -10px;
    left: 16px;
    transform: rotate(-3deg);
  }

  .newspaper-tape-tr {
    position: absolute;
    top: -10px;
    right: 16px;
    transform: rotate(2deg);
  }

  .newspaper-masthead {
    border-bottom: 2px double #23252A;
    padding-bottom: 8px;
    margin-bottom: 10px;
    text-align: center;
  }

  .newspaper-meta-bar {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--ink-muted);
    border-bottom: 1px solid #C4BEB2;
    padding-bottom: 3px;
    margin-bottom: 4px;
    text-transform: uppercase;
  }

  .newspaper-title {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 800;
    color: #121316;
    line-height: 1;
    margin: 2px 0;
    text-transform: uppercase;
  }

  .newspaper-tagline {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-style: italic;
    color: var(--ink-muted);
  }

  .newspaper-headline {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1.3;
    text-transform: uppercase;
    margin-bottom: 10px;
    border-bottom: 1px solid #D2CDC2;
    padding-bottom: 6px;
  }

  .newspaper-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    font-size: 0.78rem;
    line-height: 1.5;
    color: #1A1A1A;
    text-align: justify;
  }

  .drop-cap {
    float: left;
    font-family: var(--font-display);
    font-size: 2.2rem;
    line-height: 0.8;
    padding-top: 2px;
    padding-right: 5px;
    font-weight: 800;
    color: var(--accent-vermilion);
  }

  .newspaper-pullquote {
    border-left: 2px solid var(--accent-vermilion);
    padding-left: 8px;
    margin: 8px 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--ink-primary);
  }

  .newspaper-pullquote cite {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    font-style: normal;
    color: var(--accent-vermilion);
    margin-top: 3px;
  }

  .newspaper-stamp-bar {
    margin-top: 10px;
    padding-top: 6px;
    border-top: 1px dashed #B8B0A2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--ink-muted);
  }

  .official-seal {
    background-color: var(--accent-mint);
    color: #121316;
    padding: 2px 6px;
    border-radius: var(--radius-cut);
    border: 1px solid #121316;
  }

  @media (max-width: 900px) {
    .newspaper-columns {
      grid-template-columns: 1fr;
      text-align: left;
    }
  }
</style>

<script>
  function setupNewspaperDate() {
    const headline = document.getElementById('hero-dynamic-bday-headline');
    const subtext = document.getElementById('hero-dynamic-bday-subtext');
    const dateLabel = document.getElementById('hero-live-date-label');

    const now = new Date();
    const currentYear = now.getFullYear();
    const currentMonth = now.getMonth();
    const currentDate = now.getDate();

    const bdayDate = new Date(currentYear, 9, 28);
    const todayMidnight = new Date(currentYear, currentMonth, currentDate);
    const diffDays = Math.round((todayMidnight.getTime() - bdayDate.getTime()) / (1000 * 60 * 60 * 24));

    const monthNames = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
    if (dateLabel) {
      dateLabel.textContent = `LIVE: ${monthNames[currentMonth]} ${currentDate}`;
    }

    if (headline && subtext) {
      if (diffDays === 0) {
        headline.innerHTML = `
          <span class="cut-chunk cut-yellow">IT'S 28TH OCT</span>
          <span class="cut-chunk cut-pink">TODAY IS MY BIRTHDAY!</span>
        `;
        subtext.textContent = 'ALL HOMAGE, BLESSINGS & CAKE SLICES MUST BE SUBMITTED IMMEDIATELY.';
      } else if (diffDays === 1) {
        headline.innerHTML = `
          <span class="cut-chunk cut-yellow">YESTERDAY WAS</span>
          <span class="cut-chunk cut-pink">MY BIRTHDAY!</span>
        `;
        subtext.textContent = 'ON 28TH OF OCT I OFFICIALLY LEVELED UP. TRIBUTES STILL GRACIOUSLY ACCEPTED.';
      } else if (diffDays > 1 && diffDays <= 7) {
        headline.innerHTML = `
          <span class="cut-chunk cut-yellow">ON 28TH OF OCT</span>
          <span class="cut-chunk cut-pink">IT WAS MY BIRTHDAY</span>
          <span class="cut-chunk cut-mint">(${diffDays} DAYS AGO)</span>
        `;
        subtext.textContent = 'THE BIRTHDAY ERA IS STILL ONGOING. THE RADHE RADHE ENERGY REMAINS PEAK.';
      } else if (diffDays > 7 && diffDays <= 365) {
        headline.innerHTML = `
          <span class="cut-chunk cut-yellow">ON 28TH OF OCT</span>
          <span class="cut-chunk cut-pink">IT WAS MY BIRTHDAY</span>
        `;
        subtext.textContent = `CELEBRATING ${diffDays} DAYS OF SAINT AKI'S RADIANT ASCENSION.`;
      } else {
        const daysUntil = -diffDays;
        headline.innerHTML = `
          <span class="cut-chunk cut-yellow">MY BIRTHDAY IS ON</span>
          <span class="cut-chunk cut-pink">28TH OCT</span>
          <span class="cut-chunk cut-mint">(${daysUntil} DAYS TO GO)</span>
        `;
        subtext.textContent = "PREPARATIONS FOR SAINT AKI'S ASCENSION ARE CURRENTLY UNDERWAY.";
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNewspaperDate);
  } else {
    setupNewspaperDate();
  }
</script>
